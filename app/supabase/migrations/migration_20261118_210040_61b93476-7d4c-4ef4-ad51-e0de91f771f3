create table public.brow_down_state (owner_id uuid not null default auth.uid(), key text not null, value jsonb not null, updated_at timestamptz not null default now(), primary key(owner_id,key));
alter table public.brow_down_state enable row level security;
create policy brow_down_state_owner on public.brow_down_state for all to authenticated using (owner_id = auth.uid()) with check (owner_id = auth.uid());