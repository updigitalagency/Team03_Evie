create table public.evie_approval_events (id uuid primary key default gen_random_uuid(), studio_id uuid not null default auth.uid(), item_key text not null, event text not null, recipient_count integer, actor_id uuid not null default auth.uid(), created_at timestamptz not null default now()); alter table public.evie_approval_events enable row level security; create policy evie_approval_events_owner_read on public.evie_approval_events for select to authenticated using (studio_id = auth.uid()); create policy evie_approval_events_owner_insert on public.evie_approval_events for insert to authenticated with check (studio_id = auth.uid() and actor_id = auth.uid());