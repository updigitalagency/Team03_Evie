create table public.studio_settings (studio_id uuid primary key default auth.uid(), settings jsonb not null default '{}'::jsonb, updated_at timestamptz not null default now());
create table public.clients (id uuid primary key default gen_random_uuid(), studio_id uuid not null default auth.uid(), name text, email text, marketing_consent boolean not null default false, created_at timestamptz not null default now());
create table public.appointments (id uuid primary key default gen_random_uuid(), studio_id uuid not null default auth.uid(), source text not null, occurred_at timestamptz, service text, gross numeric, net numeric, fees numeric, client_name text, acquisition_channel text, booking_code text, raw jsonb not null default '{}'::jsonb, created_at timestamptz not null default now());
create table public.marketing_spend (id uuid primary key default gen_random_uuid(), studio_id uuid not null default auth.uid(), spent_at date, channel text, amount numeric, raw jsonb not null default '{}'::jsonb, created_at timestamptz not null default now());
create table public.drafts (id uuid primary key default gen_random_uuid(), studio_id uuid not null default auth.uid(), title text, content text, created_at timestamptz not null default now());
create table public.approvals (id uuid primary key default gen_random_uuid(), studio_id uuid not null default auth.uid(), item_key text not null, title text not null, type text not null, effect text, status text not null, approved_by uuid, approved_at timestamptz, updated_at timestamptz not null default now(), unique(studio_id,item_key));
create table public.content_codes (id uuid primary key default gen_random_uuid(), studio_id uuid not null default auth.uid(), code text not null, data jsonb not null default '{}'::jsonb, unique(studio_id,code));
create table public.integration_status (id uuid primary key default gen_random_uuid(), studio_id uuid not null default auth.uid(), source text not null, status text not null default 'not_connected', last_sync timestamptz, row_count integer not null default 0, unique(studio_id,source));
alter table public.studio_settings enable row level security; alter table public.clients enable row level security; alter table public.appointments enable row level security; alter table public.marketing_spend enable row level security; alter table public.drafts enable row level security; alter table public.approvals enable row level security; alter table public.content_codes enable row level security; alter table public.integration_status enable row level security;
