create table public.evie_demo_quota (id smallint primary key default 1 check (id = 1), calls timestamptz[] not null default '{}');
alter table public.evie_demo_quota enable row level security;
revoke all on public.evie_demo_quota from public, anon, authenticated;
create function public.evie_claim_demo_call() returns boolean language plpgsql security definer set search_path = '' as $$
declare recent timestamptz[];
begin
  insert into public.evie_demo_quota(id) values (1) on conflict (id) do nothing;
  select coalesce(array_agg(t), '{}'::timestamptz[]) into recent from unnest((select calls from public.evie_demo_quota where id = 1 for update)) as t where t > now() - interval '1 hour';
  if cardinality(recent) >= 60 then return false; end if;
  update public.evie_demo_quota set calls = array_append(recent, now()) where id = 1;
  return true;
end;
$$;
revoke all on function public.evie_claim_demo_call() from public, anon, authenticated;
grant execute on function public.evie_claim_demo_call() to service_role;